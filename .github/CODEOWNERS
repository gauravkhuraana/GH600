# CODEOWNERS decides WHO gets asked to review.
# It does not make review mandatory on its own — that needs
# "Require review from Code Owners" enabled in the ruleset.
#
# Last matching pattern wins, so the catch-all goes first.

# Default owner for everything.
*                       @udzialmeansshare

# High-impact paths. A change here can weaken the very checks
# that are supposed to validate the change.
/.github/workflows/     @udzialmeansshare
/.github/CODEOWNERS     @udzialmeansshare
/infra/                 @udzialmeansshare

# Agent configuration. Widening an agent's tools or weakening a hook is a
# governance change, not a code change.
/.github/agents/        @udzialmeansshare
/.github/hooks/         @udzialmeansshare

# Agent configuration. Widening an agent's tools or weakening a hook is a
# governance change, not a code change.
/.github/agents/        @udzialmeansshare
