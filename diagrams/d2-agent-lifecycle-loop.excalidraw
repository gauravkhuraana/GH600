    {
      "type": "text",
      "id": "d2_act_detail",
      "x": 530,
      "y": 360,
      "width": 340,
      "height": 200,
      "text": "Bounded execution\non a branch.\n\nCreate branch, change files,\ncommit, open the PR,\npush follow-ups after review.\n\nNot writing to main.\nNot deploying. Proposing.",
